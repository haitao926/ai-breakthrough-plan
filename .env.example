# Copy to a process manager secret store; do not commit real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=8090

# Required in production. Generate at least 32 random bytes.
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Teacher/Judge registration stays closed unless the matching code is set.
TEACHER_INVITE_CODE=replace-teacher-invite
JUDGE_INVITE_CODE=replace-judge-invite

# Empty means same-origin only. List exact origins separated by commas when needed.
CORS_ALLOWED_ORIGINS=
TRUST_PROXY=false

# Paths are relative to the repository root when using scripts/start.sh.
DB_PATH=storage/db/db.sqlite
UPLOAD_DIR=storage/uploads
LOG_DIR=storage/logs
ASSESSMENT_DIR=storage/assessments
COURSES_DIR=content/courses
MATERIALS_DIR=content/materials
PORTAL_DIR=content/portal
WEB_ROOT=apps/web-vue/dist
WEB_SPA=true

UPLOAD_MAX_FILE_SIZE_MB=100
BACKUP_DIR=storage/backups
